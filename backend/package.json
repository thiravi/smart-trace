{
  "name": "@samplecompany-hackathon/performancesnap-backend",
  "version": "1.0.0",
  "description": "Highly customizable backend service for consuming PerformanceSnap feedback payloads",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "mongo:start": "mongod --dbpath ./data/db",
    "mongo:import": "mongoimport --db performancesnap --collection feedback --file ./data/sample-data.json --jsonArray",
    "mongo:export": "mongoexport --db performancesnap --collection feedback --out ./data/backup.json --jsonArray",
    "fix:objectids": "tsx src/scripts/fix-objectids.ts ../performancesnap_feedbacks_last_year.json"
  },
  "keywords": [
    "feedback",
    "performance",
    "monitoring",
    "backend"
  ],
  "author": "samplecompany Hackathon Team",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "mongodb": "^6.20.0",
    "mongoose": "^8.19.2",
    "nodemailer": "^6.9.7",
    "redis": "^4.6.10",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
